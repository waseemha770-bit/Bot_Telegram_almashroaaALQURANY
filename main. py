import os
import json
import logging
import requests
import pandas as pd
from io import BytesIO
from fastapi import FastAPI, Request
from telegram import Update, ReplyKeyboardMarkup, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application, CommandHandler, CallbackQueryHandler, 
    MessageHandler, filters, ContextTypes, ConversationHandler
)

logging.basicConfig(level=logging.INFO)
app = FastAPI()

# ==========================================
# 1. إعدادات المتغيرات البيئية
# ==========================================
BOT_TOKEN = os.environ.get("BOT_TOKEN")
GAS_WEB_APP_URL = os.environ.get("GAS_WEB_APP_URL")
CHANNEL_ID = os.environ.get("CHANNEL_ID")
ADMIN_ID = str(os.environ.get("ADMIN_ID", ""))
GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY")

TIME_LIMIT_SECONDS = 30

# ==========================================
# 2. قوائم الأزرار الدائمة (Reply Keyboards)
# ==========================================
USER_KB = ReplyKeyboardMarkup([
    ["🎮 سؤال جديد", "🗂️ تغيير القسم"],
    ["🏆 لوحة الشرف", "📊 رصيدي الحالي"],
    ["⭐ المفضلة", "📚 المكتبة"],
    ["🚀 ابدأ من جديد"]
], resize_keyboard=True)

ADMIN_KB = ReplyKeyboardMarkup([
    ["🎮 سؤال جديد", "🧠 توليد أسئلة (AI)"],
    ["📚 إضافة كتاب (مباشر)", "📚 المكتبة"],
    ["🏆 لوحة الشرف", "🚀 ابدأ من جديد"]
], resize_keyboard=True)

def get_keyboard(user_id):
    if str(user_id) == ADMIN_ID:
        return ADMIN_KB
    return USER_KB

# ==========================================
# 3. دوال الاتصال بقاعدة البيانات (Google Sheets)
# ==========================================
def api_request(action, **kwargs):
    payload = {"action": action}
    payload.update(kwargs)
    try:
        res = requests.post(GAS_WEB_APP_URL, json=payload, timeout=10)
        return res.json()
    except Exception as e:
        logging.error(f"GAS API Error: {e}")
        return {"status": "error"}

# ==========================================
# 4. محرك الذكاء الاصطناعي (Gemini AI)
# ==========================================
def generate_ai_questions(text: str):
    if not GEMINI_API_KEY:
        return None
    prompt = f"""أنت خبير في إنشاء المسابقات. استخرج 3 أسئلة خيارات متعددة دقيقة من النص التالي.
يجب أن تكون النتيجة عبارة عن مصفوفة JSON صالحة (Valid JSON Array) حصراً بدون أي نصوص إضافية.
صيغة الكائن: [{{"question": "السؤال", "correct": "الصح", "wrong": ["خطأ 1", "خطأ 2", "خطأ 3"]}}]
النص: {text[:3000]}"""

    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={GEMINI_API_KEY}"
    payload = {"contents": [{"parts": [{"text": prompt}]}]}
    headers = {'Content-Type': 'application/json'}
    
    try:
        res = requests.post(url, json=payload, headers=headers).json()
        raw_text = res['candidates'][0]['content']['parts'][0]['text']
        raw_text = raw_text.replace('```json', '').replace('```', '').strip()
        return json.loads(raw_text)
    except Exception as e:
        logging.error(f"AI Error: {e}")
        return None

# ==========================================
# 5. دوال البوت الأساسية
# ==========================================
@app.get("/")
def root():
    return {"status": "active", "message": "Quran Archive & Quiz Bot is running successfully!"}

async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    api_request("register_user", user_id=user.id, name=user.first_name)
    
    welcome_msg = (
        f"مرحباً بك يا *{user.first_name}* في الأرشيف القرآني ونظام المسابقات! 🌟📖\n\n"
        f"اختر من القائمة بالأسفل للبدء:"
    )
    await update.message.reply_text(welcome_msg, parse_mode="Markdown", reply_markup=get_keyboard(user.id))

# --- نظام رفع وإدارة المكتبة ---
async def handle_book_upload(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if str(update.effective_user.id) != ADMIN_ID:
        return
        
    doc = update.message.document
    msg = await update.message.reply_text("⏳ جاري رفع الكتاب للقناة وأرشفته في قوقل شيت...")
    
    try:
        # إرسال الملف لقناة التخزين
        await context.bot.forward_message(
            chat_id=CHANNEL_ID, 
            from_chat_id=update.effective_chat.id, 
            message_id=update.message.message_id
        )
        
        book_title = doc.file_name.rsplit('.', 1)[0]
        api_request("add_item", parentId="books", name=book_title, type="file", fileId=doc.file_id)
        
        await msg.edit_text(f"✅ *تم إضافة الكتاب للمكتبة بنجاح!*\n📖 الاسم: {book_title}", parse_mode="Markdown")
    except Exception as e:
        await msg.edit_text(f"❌ حدث خطأ أثناء الرفع: تأكد أن البوت مشرف في القناة.")

async def show_library_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = "📚 *مرحباً بك في المكتبة القرآنية*\n\nجاري جلب قائمة الكتب المتوفرة..."
    msg = await update.message.reply_text(text, parse_mode="Markdown")
    
    res = api_request("get_contents", folderId="books")
    if res.get('status') != 'success' or not res.get('contents'):
        await msg.edit_text("📚 المكتبة فارغة حالياً أو لم يتم إضافة كتب بعد.")
        return

    keyboard = []
    for item in res['contents']:
        if item['type'] == 'file':
            keyboard.append([InlineKeyboardButton(f"📖 {item['name']}", callback_data=f"dlbook_{item['file_id']}")])

    await msg.edit_text("📚 *قائمة الكتب المتوفرة في المكتبة:*\nاضغط على أي كتاب لتحميله مباشرة:", reply_markup=InlineKeyboardMarkup(keyboard), parse_mode="Markdown")

async def handle_book_download(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    file_id = query.data.replace("dlbook_", "")
    await query.message.reply_text("⏳ جاري إرسال الكتاب إليك...")
    await context.bot.send_document(chat_id=update.effective_chat.id, document=file_id)

# --- نظام توليد الأسئلة بالذكاء الاصطناعي ---
async def ai_generate_request(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if str(update.effective_user.id) != ADMIN_ID:
        return ConversationHandler.END
    await update.message.reply_text("🧠 أرسل لي الآن النص (مقال أو فقرة) لاستخراج الأسئلة منه وإرسالها كملف Excel.")
    return 1

async def ai_generate_process(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    msg = await update.message.reply_text("⏳ جاري تحليل النص بالذكاء الاصطناعي...")
    
    questions = generate_ai_questions(text)
    if not questions:
        await msg.edit_text("❌ فشل استخراج الأسئلة، حاول بنص أوضح.")
        return ConversationHandler.END
        
    df = pd.DataFrame([{
        'السؤال': q['question'],
        'الإجابة الصحيحة': q['correct'],
        'خطأ 1': q['wrong'][0] if len(q['wrong'])>0 else '',
        'خطأ 2': q['wrong'][1] if len(q['wrong'])>1 else '',
        'خطأ 3': q['wrong'][2] if len(q['wrong'])>2 else '',
        'المجموعة': 'قسم الذكاء الاصطناعي'
    } for q in questions])
    
    output = BytesIO()
    with pd.ExcelWriter(output, engine='openpyxl') as writer:
        df.to_excel(writer, index=False, sheet_name='AI_Questions')
    output.seek(0)
    
    await msg.delete()
    await update.message.reply_document(
        document=output, 
        filename="AI_Generated_Questions.xlsx",
        caption="🤖 أسئلة الذكاء الاصطناعي جاهزة للمراجعة!"
    )
    return ConversationHandler.END

# ==========================================
# 6. إعداد التطبيق والمسارات (Handlers)
# ==========================================
ptb = Application.builder().token(BOT_TOKEN).build()

ai_conv_handler = ConversationHandler(
    entry_points=[MessageHandler(filters.Regex("^🧠 توليد أسئلة \(AI\)$"), ai_generate_request)],
    states={1: [MessageHandler(filters.TEXT & ~filters.COMMAND, ai_generate_process)]},
    fallbacks=[CommandHandler("start", start_command)]
)

ptb.add_handler(CommandHandler("start", start_command))
ptb.add_handler(ai_conv_handler)
ptb.add_handler(MessageHandler(filters.Regex("^📚 المكتبة$"), show_library_menu))
ptb.add_handler(CallbackQueryHandler(handle_book_download, pattern="^dlbook_"))
ptb.add_handler(MessageHandler(filters.Document.ALL & filters.Chat(int(ADMIN_ID) if ADMIN_ID else 0), handle_book_upload))

@app.post("/api/webhook")
async def process_update(request: Request):
    try:
        if not ptb._initialized: 
            await ptb.initialize()
        data = await request.json()
        await ptb.process_update(Update.de_json(data, ptb.bot))
        return {"status": "ok"}
    except Exception as e: 
        logging.error(f"Webhook Error: {e}")
        return {"status": "error"}
